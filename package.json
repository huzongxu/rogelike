{
  "name": "echo-abyss",
  "private": true,
  "version": "0.1.0",
  "description": "《回响深渊》核心循环 MVP —— 挂机放置 + 暗黑Like装备 + 吸血鬼幸存者Like割草 (Canvas 自研引擎, 浏览器可玩, 预留微信小游戏移植)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lab": "vite --open /layout-lab.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:minigame": "vite build --config vite.config.minigame.ts && node scripts/copy-assets.cjs",
    "smoke:wechat": "node scripts/smoke-wechat.cjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
